{
  "name": "code-map",
  "version": "0.1.0",
  "description": "Interactive dependency graph visualizer for JS/TS codebases",
  "type": "module",
  "bin": {
    "code-map": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "build:extension": "npm run build --prefix extension",
    "test:extension": "npm test --prefix extension",
    "test:extension:integration": "npm run test:integration --prefix extension",
    "package:extension": "npm run package --prefix extension",
    "demo": "node dist/cli.js examples/demo --no-ai --run \"node main.mjs\"",
    "build": "tsc -p tsconfig.json && npm run build --prefix web",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/hostedCli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "ignore": "^6.0.2",
    "open": "^10.1.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.6"
  }
}
