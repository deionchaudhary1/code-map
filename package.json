{
  "name": "code-map",
  "version": "0.1.0",
  "description": "Interactive dependency graph visualizer for JS/TS codebases",
  "type": "module",
  "bin": {
    "code-map": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --prefix web",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "ignore": "^6.0.2",
    "open": "^10.1.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
